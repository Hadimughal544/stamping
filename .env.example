# Neon connection string (Neon console → Connect → "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Any long random string, used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Base URL encoded in the stamp QR codes. Leave empty to use the address in the browser.
# Set it to something a phone can open, e.g. http://192.168.1.5:3000 (LAN) or your deployed domain.
APP_URL=""

# Set to "true" to require OTP contact verification before issuing stamps.
OTP_ENABLED="false"
